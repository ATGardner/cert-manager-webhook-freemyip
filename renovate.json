{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":prHourlyLimitNone"
  ],
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "timezone": "Asia/Jerusalem",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "rebaseWhen": "behind-base-branch",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Automerge non-major updates. Riskier managers opt out below.",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Actions bumps touch the release workflow, where a bad version fails quietly instead of turning CI red. Digests stay pinned by helpers:pinGitHubActionDigestsToSemver; merge by hand.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "automerge": false
    },
    {
      "description": "Base-image digest refreshes are content-identical rebuilds; CI is enough.",
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies"
    },
    {
      "description": "k8s.io/* and controller-runtime versions are dictated by the cert-manager release (broke the build when bumped past it, see v0.3.0). They move via go mod tidy when cert-manager itself is bumped.",
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/apiextensions-apiserver",
        "k8s.io/apiserver",
        "k8s.io/client-go",
        "k8s.io/component-base",
        "sigs.k8s.io/controller-runtime"
      ],
      "enabled": false
    }
  ]
}
